# =========================================================================
# Unity Official Exclusions
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Android build artifacts (Unity 6+)
.utmp/

# =========================================================================
# Asset & Material Exclusions
# =========================================================================
# By default, Unity supports Blender asset imports. 
# .blend1 backup files do not need to be committed.
*.blend1
*.blend1.meta

# =========================================================================
# Source Control / IDE Exclusions
# =========================================================================
# Visual Studio / Rider / VS Code autogenerated files
/[As]ssets/AssetStoreTools*
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Autogenerated JetBrains Rider plugin files
/[As]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# =========================================================================
# OS Generated Files
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
